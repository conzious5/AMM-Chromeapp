OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DEV_AUTH_TOKEN=replace-with-a-long-random-token
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=chrome-extension://your-extension-id
MAX_DRAFT_CHARS=12000
MAX_THREAD_CHARS=30000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:3000
# Temporary bootstrap inputs. Set for one deployment only, then remove.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TEAM_PASSWORD=
# Local development fallback only. Production sender permissions live in PostgreSQL.
USER_SENDER_PERMISSIONS_JSON={"cylina@authentic-moments.com":["cylina@authentic-moments.com","hello@authentic-moments.com"]}
