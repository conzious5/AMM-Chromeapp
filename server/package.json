{
  "name": "@amm/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx src/evals/run.ts",
    "analyze:takeout": "tsx src/training/importTakeout.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@prisma/client": "^6.16.2",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "mailparser": "^3.7.4",
    "openai": "^5.20.2",
    "prisma": "^6.16.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
