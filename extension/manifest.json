{
  "manifest_version": 3,
  "name": "AMM Voice",
  "version": "0.1.2",
  "description": "Authentic Moments client-email writing assistant.",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*", "https://ammserver-production.up.railway.app/*", "http://localhost:3000/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{ "matches": ["https://mail.google.com/*"], "js": ["core.js", "compose-adapter.js", "compose-lifecycle.js", "outbound-coaching.js", "content-script.js"], "css": ["content-style.css"], "run_at": "document_idle" }],
  "options_page": "options.html",
  "action": { "default_title": "AMM Voice settings" }
}
